# 复制本文件为 .env 并填入你的密钥
# DeepSeek API 密钥（必填）：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxx

# HuggingFace 镜像（国内网络必需）
HF_ENDPOINT=https://hf-mirror.com
# 禁用 Xet 下载协议（镜像不支持该协议，会导致大文件 401）
HF_HUB_DISABLE_XET=1

# ---- Web 会话功能（可选）----
# Web 界面访问口令：设置后浏览器打开即出现登录页，且侧栏显示历史会话列表
# （Chainlit 要求数据持久化 + 登录同时开启才渲染历史列表）。
# 不设置则无登录（本机单人使用）。
CHAINLIT_WEB_PASSWORD=
# 登录 JWT 签名密钥：启用口令登录时建议设置一个随机长字符串
# （如 `python -c "import secrets; print(secrets.token_hex(32))"` 生成）。
# 不设置时每次启动随机生成（重启后需要重新登录）。
CHAINLIT_AUTH_SECRET=

